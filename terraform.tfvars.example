# terraform.tfvars.example - Example variable values
# Copy this file to terraform.tfvars and update with your values

# General configuration
project_name = "my-ecs-app"
environment  = "dev"
aws_region   = "us-west-2"

# Default tags to apply to all resources
default_tags = {
  Project     = "my-ecs-app"
  Environment = "dev"
  ManagedBy   = "terraform"
  Owner       = "devops-team"
  CostCenter  = "12345"
}

# Networking configuration
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-west-2a", "us-west-2b", "us-west-2c"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24", "10.0.13.0/24"]

# ECS configuration
container_insights = true
container_name     = "my-app"
container_image    = "123456789012.dkr.ecr.us-west-2.amazonaws.com/my-app:latest"
container_port     = 8080
container_cpu      = 512
container_memory   = 1024
desired_count      = 2

# Load balancer configuration
create_load_balancer = true
health_check_path    = "/health"

# Auto scaling configuration
enable_autoscaling   = true
min_capacity         = 2
max_capacity         = 10
cpu_target_value     = 70
memory_target_value  = 80

# Monitoring configuration
enable_monitoring             = true
cpu_utilization_threshold     = 85
memory_utilization_threshold  = 85
create_sns_topic              = true
# sns_email_list              = ["alerts@example.com"] # Uncomment and add your emails